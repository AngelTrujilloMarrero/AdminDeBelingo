    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "match-sorter": "^8.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-resizable-panels": "^4.11.2",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
