    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "match-sorter": "^8.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
